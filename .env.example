# =====================================================
# HOUZZ LEAD GENERATION PIPELINE v2.0 - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and fill in your actual API keys
# =====================================================

# =====================================================
# REQUIRED API KEYS
# =====================================================

# ZeroBounce API Key (Required for email verification)
# Get your API key from: https://www.zerobounce.net/
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# =====================================================
# OPTIONAL PROXY CONFIGURATION
# =====================================================

# Proxy Authentication (Optional)
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

# Proxy Rotation Settings (Optional)
USE_PROXY_ROTATION=true
PROXY_ROTATION_INTERVAL=10

# Webshare Proxy Settings (Optional)
# Get your API key from: https://webshare.io/
WEBSHARE_API_KEY=your_webshare_api_key
WEBSHARE_PROXY_LIST=your_proxy_list_url

# =====================================================
# ENVIRONMENT SETTINGS
# =====================================================

# Browser Settings
HEADLESS=true
TIMEOUT=45

# Scraping Limits
MAX_PAGES_PER_STATE=50

# Output Directories
OUTPUT_DIR=data
LOG_DIR=logs

# =====================================================
# NOTES
# =====================================================
# 
# 1. ZEROBOUNCE_API_KEY: Required for production-grade email verification
#    - Free tier: 100 verifications per day
#    - Paid plans available for higher volumes
#    - Get API key: https://www.zerobounce.net/
#
# 2. PROXY SETTINGS: Optional for anti-detection
#    - Use proxy rotation for large-scale scraping
#    - Webshare.io provides reliable proxy services
#
# 3. ENVIRONMENT SETTINGS: Adjust based on your needs
#    - HEADLESS=true: Run browser in background (recommended)
#    - TIMEOUT=45: Browser timeout in seconds
#    - MAX_PAGES_PER_STATE=50: Limit pages per state (adjust as needed)
#
# =====================================================
