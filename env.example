# =====================================================
# HOUZZ LEAD GENERATION PIPELINE - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and configure your API keys
# =====================================================

# =====================================================
# REQUIRED API KEYS (for full functionality)
# =====================================================

# ZeroBounce API Key for email verification
# Get your API key at: https://www.zerobounce.net/
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# Google Custom Search API Key
# Get your API key at: https://console.cloud.google.com/
GOOGLE_SEARCH_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID (CX)
# Create at: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_CX=your_google_custom_search_engine_id_here

# =====================================================
# GOOGLE SHEETS INTEGRATION (Auto-enabled when configured)
# =====================================================
# Google Sheets integration is automatically enabled when credentials are provided

# Google Sheets Spreadsheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Worksheet name to update (default: "Sheet1")
GOOGLE_SHEETS_WORKSHEET_NAME=Sheet1

# Second Google Sheet for Profile Data
GOOGLE_SHEETS_PROFILES_SPREADSHEET_ID=your_profiles_spreadsheet_id_here
GOOGLE_SHEETS_PROFILES_WORKSHEET_NAME=Profiles

# =====================================================
# GOOGLE SERVICE ACCOUNT CREDENTIALS (Required for Google Sheets)
# =====================================================
# Extract these values from your service account JSON file
# Download JSON from: https://console.cloud.google.com/iam-admin/serviceaccounts

# Required credentials - extract from your service account JSON file
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PROJECT_ID=your-google-cloud-project-id

# =====================================================
# OPTIONAL PROXY SETTINGS
# =====================================================

# Enable proxy rotation (true/false)
USE_PROXY_ROTATION=true

# Proxy credentials
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

# Proxy rotation interval (requests)
PROXY_ROTATION_INTERVAL=10

# Webshare proxy settings
WEBSHARE_API_KEY=your_webshare_api_key
WEBSHARE_PROXY_LIST=your_proxy_list_url

# =====================================================
# APPLICATION SETTINGS
# =====================================================

# Browser settings
HEADLESS=true
TIMEOUT=45

# Scraping limits
MAX_PAGES_PER_STATE=50

# Output directories
OUTPUT_DIR=data
LOG_DIR=logs

# =====================================================
# DOCKER SETTINGS (for containerized deployment)
# =====================================================

# Log level for containerized deployment
LOG_LEVEL=INFO

# =====================================================
# NOTES
# =====================================================
# 
# 1. Copy this file to .env: cp env.example .env
# 2. Replace placeholder values with your actual API keys
# 3. The application can run without API keys but with reduced functionality:
#    - Without ZeroBounce: Basic email validation only
#    - Without Google APIs: No Gmail discovery or social media enrichment
# 4. For Docker deployment, ensure .env file is in the same directory as docker-compose.yml
# 5. Never commit .env file to version control
#
# =====================================================
